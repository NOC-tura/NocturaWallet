{
  "name": "noctura-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --exclude '**/no-external-hosts.test.ts'",
    "test:bundle": "vitest run no-external-hosts",
    "scan": "node scripts/check-no-secrets.mjs src ../core && node scripts/check-no-secrets.mjs --bundle dist",
    "csp": "node scripts/check-csp.mjs dist",
    "manifest": "node scripts/build-manifest.mjs dist",
    "reproducible": "node scripts/verify-reproducible.mjs",
    "verify": "rm -rf dist && npm run build && npm run test && npm run test:bundle && npm run scan && npm run csp && npm run reproducible && npm run manifest"
  },
  "dependencies": {
    "@scure/base": "^2.4.0",
    "@solana/wallet-adapter-base": "^0.9.28",
    "@solana/wallet-adapter-react": "^0.15.40",
    "@solana/wallet-adapter-react-ui": "^0.9.40",
    "@solana/web3.js": "^1.99.0",
    "@tanstack/react-query": "^5.103.2",
    "buffer": "^6.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.5",
    "jsdom": "^24.1.0",
    "typescript": "^5.5.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "@types/react": "$@types/react"
  }
}

# Release signing credentials. Copy to android/keystore.properties (gitignored)
# and fill in. NEVER put these in android/gradle.properties — that file is
# tracked in git.
#
# Create the keystore first (interactive, so the password is never in a shell
# history or a log):
#
#   keytool -genkeypair -v \
#     -keystore android/app/noctura-release.jks \
#     -alias noctura-upload \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# storeFile is resolved relative to android/app/.
storeFile=noctura-release.jks
storePassword=
keyAlias=noctura-upload
keyPassword=

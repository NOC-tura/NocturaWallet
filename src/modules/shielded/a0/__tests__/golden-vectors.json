{
  "schema": "noctura.zk.golden-vectors/1",
  "_notAnInput": "COMPUTE these from §1.4a and COMPARE. Do not read them into a builder: the same number on both sides of an equals sign always matches, and a wrong value in this file would then surface as a green test on both sides at once. A defect in a shared artefact shows up as AGREEMENT — that is why each repo needs a path from the frozen spec to a test that passes through no shared file, and this is that file for the positive half.",
  "_provenance": "Each value is computed with poseidon-lite AND validated by the compiled circuit accepting a witness built from it — two independent implementations (poseidon-lite vs circom+circomlib inside the R1CS) agreeing. The validator carries its own negative control: a commitment off by one must be REJECTED, or the generator refuses to write this file.",
  "_byteOrder": "32-byte BIG-ENDIAN hex, unprefixed, zero-padded — what the on-chain verifier reads. Two implementations can agree on every integer here and still disagree on the bytes, and the bytes are the half that fails at the verifier instead of in a unit test.",
  "_notValidatedHere": "THE EMPTY-SUBTREE CONSTANTS. Z[i] = P2(Z[i-1], Z[i-1]) starting from 0 are the values an empty tree is built from, and NOTHING IN THIS FILE PINS THEM: the circuit accepts any path, so they enter a witness as arbitrary sibling data and cancel on both sides. A wallet using different constants still proves membership here and computes wrong roots against the real tree. They must be checked against the DEPLOYED PROGRAM's tree initialization, which is A0.4's on-chain half — named here so the gap is a stated limit rather than an assumption. Found by a gate self-test that mutated them and was published clean; a mutant that changes nothing is information.",
  "_tags": {
    "TAG_CM": "0x10",
    "TAG_NULL": "0x11",
    "TAG_ADDR": "0x12",
    "TAG_RHO": "0x13",
    "_burned": "0x01-0x0F are the entire old scheme and must never be reused",
    "_untagged": "the Merkle node is Poseidon2(left, right) with NO tag — the single named exception"
  },
  "equations": {
    "addrField": "Poseidon3(TAG_ADDR, nk, d)",
    "commitment": "Poseidon5(TAG_CM, addrField, amount, mintHash, rho)",
    "nullifier": "Poseidon3(TAG_NULL, nk, rho)",
    "rhoOut": "Poseidon3(TAG_RHO, nullifier_in_0, j)",
    "merkleNode": "Poseidon2(left, right)   // UNTAGGED"
  },

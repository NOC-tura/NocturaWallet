  "instructions": [
    {
      "name": "deposit",
      "docs": [
        "A0 deposit. FOUR public inputs now: (commitment, amount, mintHash, rho), in the order the",
        "circuit declares them — `component main {public [commitment, amount, mintHash, rho]}`.",
        "",
        "`rho` is public precisely so the program can `init` the PDA [\"rho\", rho] FROM THE VALUE THE",
        "PROOF IS BOUND TO. Both appear inside cm === P5(TAG_CM, addrField, amount, mintHash, rho),",
        "so the rho the marker reserves is provably the rho inside the note — a marker keyed off a",
        "caller-supplied value the proof did not commit to would reserve a number and protect",
        "nothing.",
        "",
        "`rho` sits BEFORE `proof_bytes` in the argument list because the seeds constraint needs it",
        "in `#[instruction(..)]`, and every argument before it has to be listed there. Ordering an",
        "instruction's arguments around an account constraint is not elegant, but the alternative is",
        "carrying a Vec<u8> into the accounts context for no reason."
      ],
      "discriminator": [
        242,
        35,
        198,
        137,
        82,
        225,
        242,
        182
      ],
